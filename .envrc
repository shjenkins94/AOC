__conda_setup="$('/lustre10/home/shjenkinsku/miniforge3/bin/conda' 'shell.bash' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "/lustre10/home/shjenkinsku/miniforge3/etc/profile.d/conda.sh" ]; then
        . "/lustre10/home/shjenkinsku/miniforge3/etc/profile.d/conda.sh"
    else
        export PATH="/lustre10/home/shjenkinsku/miniforge3/bin:$PATH"
    fi
fi
unset __conda_setup

if [ -f "/lustre10/home/shjenkinsku/miniforge3/etc/profile.d/mamba.sh" ]; then
