rule macse:
    input:
        fasta=lambda wildcards: CODON_FASTA_BY_SEQUENCE[wildcards.sequence],
    output:
        codons="results/sequences/{sequence}/{sequence}.codons.fa",
        aa="results/sequences/{sequence}/{sequence}.aa.fa",
    resources:
        mem_mb=_macse_requested_mem_mb(),
        xms_mb=MACSE_XMS_MB,
        xmx_mb=_macse_heap_mb(),
    log:
        "logs/macse/macse.{sequence}.log",
    container:
        "docker://quay.io/biocontainers/macse:2.07--hdfd78af_0"
    shell:
        r"""
        bash "{MACSE_RUNNER}" \
          --macse-bin "{MACSE_LAUNCHER}" \
          --xms-mb {resources.xms_mb} \
          --xmx-mb {resources.xmx_mb} \
          -- \
          -prog alignSequences \
          -seq "{input.fasta}" \
          -out_NT "{output.codons}" \
          -out_AA "{output.aa}" \
          -max_refine_iter 3 \
          -local_realign_init 0.3 \
          -local_realign_dec 0.2 \
          > {log} 2>&1
        """

rule cln:
    input:
        codons=rules.macse.output.codons
    output:
        cln="results/sequences/{sequence}/{sequence}.codons.cln.fa"
    log:
        "logs/cln/cln.{sequence}.log"
    container:
        "docker://pegi3s/hyphy:2.5.103"
    shell:
        r"""
        {HYPHY} CLN --code Universal --alignment {input.codons} --filtering-method 'No/No' --output {output.cln} > {log} 2>&1
        """

rule strike_ambigs_msa:
    input:
        cln=rules.cln.output.cln
    output:
        sa="results/sequences/{sequence}/{sequence}.SA.codons.cln.fa"
    log:
        "logs/strike_ambigs_msa/strike_ambigs_msa.{sequence}.log"
    container:
        "docker://pegi3s/hyphy:2.5.103"
    shell:
        r"""
        {HYPHY} {STRIKE_AMBIGS_BF} --alignment {input.cln} --output {output.sa} > {log} 2>&1
        """

rule remove_duplicates_msa:
    input:
        sa=rules.strike_ambigs_msa.output.sa,
    output:
        rd="results/sequences/{sequence}/{sequence}.RD.SA.codons.cln.fa"
    log:
        "logs/remove_duplicates_msa/remove_duplicates_msa.{sequence}.log"
    container:
        "docker://pegi3s/hyphy:2.5.103"
    shell:
        """
        {HYPHY} remove-duplicates --msa {input.sa} --output {output.rd} ENV='DATA_FILE_PRINT_FORMAT=9' > {log} 2>&1
        """


rule tn93_cluster:
    input:
        rd=rules.remove_duplicates_msa.output.rd,
    output:
        cluster_json="results/sequences/{sequence}/{sequence}.RD.SA.codons.cln.fa.cluster.json",
        cluster_fasta="results/sequences/{sequence}/{sequence}.RD.SA.codons.cln.fa.cluster.fasta",
    params:
        threshold=lambda wc: config.get("tn93_threshold", 0.01),
        max_seqs=lambda wc: config.get("tn93_max_seqs", 20),
    log:
        "logs/tn93_cluster/tn93_cluster.{sequence}.log"
    container:
        "docker://sjenkins94/aoc-tn93:0.2"
    shell:
        """
        python {TN93_CLUSTER_PY} \
            --input {input.rd} \
            --output_fasta {output.cluster_fasta} \
            --output_json {output.cluster_json} \
            --threshold {params.threshold} \
            --max_retain {params.max_seqs} \
            > {log} 2>&1
        """
    
rule recombination:
    input:
        msa=rules.tn93_cluster.output.cluster_fasta
    output:
        gard_json=protected("results/sequences/{sequence}/{sequence}.RD.SA.codons.cln.fa.cluster.fasta.GARD.json"),
        bestgard=protected("results/sequences/{sequence}/{sequence}.RD.SA.codons.cln.fa.cluster.fasta.best-gard"),
    threads:
        GARD_PROCESSORS
    log:
        "logs/recombination/recombination.{sequence}.log"
    container:
        "docker://sjenkins94/hyphy3:v1.1"
    shell:
        r"""
        {HYPHY_3} GARD -t {threads} --alignment {input.msa} --output {output.gard_json} > {log} 2>&1
        """

