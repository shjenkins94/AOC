###############################################################################
# Preprocessing
###############################################################################


ruleorder:
    macse
    > cln
    > strike_ambigs_msa
    > remove_duplicates_msa
    > tn93_cluster
    > check_msa
    > recombination
    > label_gard_TestForeground
    > FEL
    > MEME
    > BUSTEDS_MH
    > RELAX
    > parse_gard
    > fasttree_partition
    > label_tree_TestForeground_partition
    > ABSREL_partition
    > CFEL_partition
    > run_selection_all_partitions
    > PlotFEL
    > PlotMEME
