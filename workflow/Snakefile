rule PlotFEL:
    input:
        json=rules.FEL.output.json,
    output:
        output_csv="results/{sample}/tables/{sample}.AOC.FEL_Results.csv",
        output_png="results/{sample}/visualizations/{sample}.FEL.png",
        output_svg="results/{sample}/visualizations/{sample}.FEL.svg",
        output_figureLegend="results/{sample}/visualizations/{sample}.FEL.figure_legend.txt",
    log:
        "logs/PlotFEL_partition.{sample}.log",
    run:
        data = _read_json(input.json)
        headers = _hyphy_headers(data)
        all_dfs = []
        for part in data["MLE"]["content"]:
            df = pd.DataFrame(
                _hyphy_content_table(data, part), columns=headers, dtype=float
            )
            df.insert(0, "Partition", int(part) + 1)
            df.insert(0, "Sample", wildcards.sample)
            all_dfs.append(df)
        merged_df = (
            pd.concat(all_dfs, ignore_index=True)
            if all_dfs
            else pd.DataFrame(columns=["Sample", "Partition"])
        )
        merged_df.index += 1
        merged_df["CodonSite"] = merged_df.index
        merged_df["adjusted_p-value"] = _safe_fdrcorrection(
            merged_df["p-value"].tolist(), alpha=0.10
        )
        merged_df.to_csv(output.output_csv, index=False)
        source = (
            merged_df.copy()
            .dropna()
            .rename(
                columns={
                    "p-value": "p_value",
                    "adjusted_p-value": "adjusted_p_value",
                }
            )
        )
        line = (
            alt.Chart(source)
            .mark_circle(clip=True, opacity=0.9, size=70)
            .encode(
                x=alt.X("CodonSite:Q", title="Codon site"),
                y=alt.Y(
                    "dN/dS MLE:Q",
                    title="dN/dS estimate",
                    scale=alt.Scale(
                        domain=(0, 5), clamp=True, nice=False, type="sqrt"
                    ),
                ),
                color=alt.condition(
                    "datum.adjusted_p_value <= 0.1",
                    alt.value("red"),
                    alt.value("lightgray"),
                ),
                tooltip=[
                    "CodonSite",
                    "alpha",
                    "beta",
                    "dN/dS MLE",
                    "p_value",
                    "adjusted_p_value",
                ],
            )
            .properties(width=900, height=450, title=f"FEL: {wildcards.sample}")
        )
        band = (
            alt.Chart(source)
            .mark_area(opacity=0.25)
            .encode(x="CodonSite:Q", y="dN/dS LB:Q", y2="dN/dS UB:Q")
        )
        chart = band + line
        save_altair_with_vl_convert(
            chart, svg_path=output.output_svg, png_path=output.output_png, scale=2
        )
        sig = merged_df[merged_df["adjusted_p-value"] <= 0.10]
        pos = sig[sig["dN/dS MLE"] > 1.0]
        neg = sig[sig["dN/dS MLE"] < 1.0]
        with open(output.output_figureLegend, "w") as fh:
            fh.write(
                f"FEL identified {len(sig)} significant codon sites in {wildcards.sample} at FDR <= 0.10, including {len(pos)} sites with dN/dS > 1 and {len(neg)} sites with dN/dS < 1.\n"
            )


rule PlotMEME:
    input:
        json=rules.MEME.output.json,
    output:
        output_csv="results/{sample}/tables/{sample}.AOC.MEME_Results.csv",
        output_png="results/{sample}/visualizations/{sample}.MEME.png",
        output_svg="results/{sample}/visualizations/{sample}.MEME.svg",
        output_figureLegend="results/{sample}/visualizations/{sample}.MEME.figure_legend.txt",
    log:
        "logs/PlotMEME.{sample}.log",
    run:
        data = _read_json(input.json)
        headers = _hyphy_headers(data)
        all_dfs = []
        for part in data["MLE"]["content"]:
            df = pd.DataFrame(
                _hyphy_content_table(data, part), columns=headers, dtype=float
            )
            df.insert(0, "Partition", int(part) + 1)
            df.insert(0, "Sample", wildcards.sample)
            all_dfs.append(df)
        merged_df = (
            pd.concat(all_dfs, ignore_index=True)
            if all_dfs
            else pd.DataFrame(columns=["Sample", "Partition"])
        )
        merged_df.index += 1
        merged_df["CodonSite"] = merged_df.index
        merged_df["adjusted_p-value"] = _safe_fdrcorrection(
            merged_df["p-value"].tolist(), alpha=0.10
        )
        merged_df.to_csv(output.output_csv, index=False)
        source = merged_df.copy().rename(
            columns={
                "p-value": "p_value",
                "adjusted_p-value": "adjusted_p_value",
                "beta+": "beta_plus",
            }
        )
        tooltip_fields = [alt.Tooltip("CodonSite:Q", title="Codon site")]
        if "alpha" in source.columns:
            tooltip_fields.append(alt.Tooltip("alpha:Q", title="alpha"))
        if "beta_plus" in source.columns:
            tooltip_fields.append(alt.Tooltip("beta_plus:Q", title="beta+"))
        if "p_value" in source.columns:
            tooltip_fields.append(alt.Tooltip("p_value:Q", title="p-value"))
        tooltip_fields.append(
            alt.Tooltip("adjusted_p_value:Q", title="adjusted p-value")
        )
        chart = (
            alt.Chart(source)
            .mark_point(size=55)
            .encode(
                x=alt.X("CodonSite:Q", title="Codon site"),
                y=alt.Y("adjusted_p_value:Q", title="Adjusted p-value"),
                color=alt.Color(
                    "adjusted_p_value:Q",
                    scale=alt.Scale(scheme="reds", reverse=True),
                ),
                tooltip=tooltip_fields,
            )
            .properties(width=900, height=450, title=f"MEME: {wildcards.sample}")
        )
        save_altair_with_vl_convert(
            chart, svg_path=output.output_svg, png_path=output.output_png, scale=2
        )
        sig = merged_df[merged_df["adjusted_p-value"] <= 0.10]
        with open(output.output_figureLegend, "w") as fh:
            fh.write(
                f"MEME identified {len(sig)} significant codon sites in {wildcards.sample} at FDR <= 0.10, consistent with episodic selection along a subset of branches.\n"
            )


