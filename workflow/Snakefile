rule fasttree_partition:
    input:
        aln=_partition_fasta,
    output:
        tree="results/{sample}/selection/part{part}/FastTree.treefile",
    log:
        "logs/fasttree_partition.{sample}.part{part}.log",
    shell:
        r"""
        {FASTTREE} -nt -gtr {input.aln} >{output.tree} 2>{log}
        """


rule label_tree_TestForeground_partition:
    input:
        tree=rules.fasttree_partition.output.tree,
        test_list=lambda wildcards: f"results/{{sample}}/{{sample}}.{SEQUENCE_BY_SAMPLE[wildcards.sample]}.test_sequences.txt",
    output:
        tree="results/{sample}/selection/part{part}/FastTree.labelled.treefile",
    log:
        "logs/label_tree_TestForeground_partition.{sample}.part{part}.log",
    run:
        with open(log[0] if hasattr(log, "__iter__") else str(log), "a") as L:
            L.write("START\n")
        if (
            (input.test_list is None)
            or (not os.path.exists(input.test_list))
            or (os.path.getsize(input.test_list) == 0)
        ):
            shell("cp {input.tree} {output.tree}")
            with open(log[0] if hasattr(log, "__iter__") else str(log), "a") as L:
                L.write("No test list; copied tree\nEND\n")
        else:
            cmd = (
                f"{HYPHY} {LABEL_TREE_BF} "
                f"--tree {input.tree} "
                f"--list {input.test_list} "
                f"--output {output.tree} "
                f"--label Test"
            )
            shell(
                cmd
                + " > "
                + (log[0] if hasattr(log, "__iter__") else str(log))
                + " 2>&1"
            )
            with open(log[0] if hasattr(log, "__iter__") else str(log), "a") as L:
                L.write("END\n")


rule ABSREL_partition:
