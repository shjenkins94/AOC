def _overview_inputs_for_sample(wc):
    outs = [
        os.path.join(
            str(OUTROOT), wc.sample, "tables", f"{wc.sample}.AOC.merged_FEL_Results.csv"
        ),
        os.path.join(
            str(OUTROOT),
            wc.sample,
            "tables",
            f"{wc.sample}.AOC.merged_MEME_Results.csv",
        ),
    ]
    for part in _parts_for_sample(wc):
        for test in ["ABSREL", "BUSTEDS-MH", "RELAX", "CFEL"]:
            outs.append(
                os.path.join(selection_part_dir(wc.sample, part), f"{test}.json")
            )
    return outs


def _overview_inputs_for_sample_all_partitions(wc):
    outs = expand(
        "results/{{sample}}/tables/{{sample}}.AOC.{test}_Results.csv",
        test=["FEL", "MEME", "BUSTEDS-MH", "RELAX"],
    )
    return outs


# Runs once the test list and final MSA are available, and aggregates the test results for a given sample.
def _aggregate_test_results(wildcards):
    # By default, run all tests with run=True in tests.csv
    tests_to_run = tests_df[tests_df["run"]]
    ck = checkpoints.check_msa.get(
        sample=wildcards.sample, sequence=SEQUENCE_BY_SAMPLE[wildcards.sample]
    )
    with open(ck.output.filtered_ids) as filtered_id_fh:
        # First check if sample has labels CSV
        if TEST_HEADERS_BY_SAMPLE.get(wildcards.sample, False):
            # get alignment and test IDs
            with open(ck.output.filtered_ids) as fh:
                test_id_count = sum(1 for line in fh)
                if test_id_count == 0:
                    # Don't run any tests if there are no test sequences in the alignment
                    return {"skipped": "results/{sample}/SKIPPED.done"}
        else:
            # If no labels CSV, skip tests that require labels (RELAX, CFEL)
            tests_to_run = tests_to_run[~tests_to_run["requires_labels"]]

        plotted_tests = tests_to_run[tests_to_run["plot"]]["program"].tolist()
        plotted_test_results = expand(
            "results/{{sample}}/tables/{{sample}}.AOC.{program}_Results.csv",
            program=plotted_tests,
        )
        plotted_test_dict = dict(zip(plotted_tests, plotted_test_results))

        # get remaining tests
        tests_to_run = tests_to_run[~tests_to_run["plot"]]

        direct_gard_tests = tests_to_run[tests_to_run["direct_gard"]][
            "program"
        ].tolist()
        direct_gard_results = expand(
            "results/{{sample}}/selection/{{sample}}.{test}.json",
            test=direct_gard_tests,
        )
        direct_gard_dict = dict(zip(direct_gard_tests, direct_gard_results))

        # get remaining partitioned tests
        partitioned_tests = tests_to_run[~tests_to_run["direct_gard"]][
            "program"
        ].tolist()
        partitioned_test_dict = {}
        for pt in partitioned_tests:
            partitioned_test_dict[pt] = expand(
                "results/{{sample}}/selection/part{part}/{test}.json",
                part=_parts_for_sample(wildcards),
                test=[pt],
            )
        return plotted_test_dict | direct_gard_dict | partitioned_test_dict


rule SelectionSkipped:
    output:
        touch("results/{sample}/SKIPPED.done"),
    log:
        "logs/SelectionSkipped.{sample}.log",
    run:
        with open(log[0] if hasattr(log, "__iter__") else str(log), "a") as L:
            L.write("No test sequences found in alignment\n")


rule SelectionOverviewTable:
    input:
        unpack(_aggregate_test_results),
    output:
        csv="results/{sample}/tables/{sample}.selection_overview.csv",
    log:
        "logs/SelectionOverviewTable.{sample}.log",
    run:
        rows = []
        if input.get("skipped"):
            rows.append(
                {
                    "sample": wildcards.sample,
                    "partition": None,
                    "method": "All",
                    "metric": "status",
                    "value": "skipped",
                }
            )
        else:
            if input.get("FEL"):
                fel = pd.read_csv(input.FEL)
                if not fel.empty:
                    if (
                        "adjusted_p-value" in fel.columns
                        and "Partition" in fel.columns
                    ):
                        fel["adjusted_p-value"] = pd.to_numeric(
                            fel["adjusted_p-value"], errors="coerce"
                        )
                        for part, subdf in fel.groupby("Partition"):
                            rows.append(
                                {
                                    "sample": wildcards.sample,
                                    "partition": part,
                                    "method": "FEL",
                                    "metric": "significant_sites_FDR_0.10",
                                    "value": int(
                                        (subdf["adjusted_p-value"] <= 0.10).sum()
                                    ),
                                }
                            )
                    else:
                        rows.append(
                            {
                                "sample": wildcards.sample,
                                "partition": "all",
                                "method": "FEL",
                                "metric": "significant_sites_FDR_0.10",
                                "value": 0,
                            }
                        )
            if input.get("MEME"):
                meme = pd.read_csv(input.MEME)
                if not meme.empty:
                    if (
                        "adjusted_p-value" in meme.columns
                        and "Partition" in meme.columns
                    ):
                        meme["adjusted_p-value"] = pd.to_numeric(
                            meme["adjusted_p-value"], errors="coerce"
                        )
                        for part, subdf in meme.groupby("Partition"):
                            rows.append(
                                {
                                    "sample": wildcards.sample,
                                    "partition": part,
                                    "method": "MEME",
                                    "metric": "significant_sites_FDR_0.10",
                                    "value": int(
                                        (subdf["adjusted_p-value"] <= 0.10).sum()
                                    ),
                                }
                            )
                    else:
                        rows.append(
                            {
                                "sample": wildcards.sample,
                                "partition": "all",
                                "method": "MEME",
                                "metric": "significant_sites_FDR_0.10",
                                "value": 0,
                            }
                        )
            if input.get("BUSTEDS-MH"):
                busted_data = _read_json(input.get("BUSTEDS-MH"))
                if busted_data.get("skipped"):
                    rows.append(
                        {
                            "sample": wildcards.sample,
                            "partition": None,
                            "method": "BUSTEDS-MH",
                            "metric": "status",
                            "value": "skipped",
                        }
                    )
                else:
                    pval = busted_data.get("test results", {}).get("p-value", None)
                    rows.append(
                        {
                            "sample": wildcards.sample,
                            "partition": "All",
                            "method": "BUSTEDS-MH",
                            "metric": "gene_wide_pvalue",
                            "value": pval,
                        }
                    )
            if input.get("RELAX"):
                relax_data = _read_json(input.RELAX)
                if relax_data.get("skipped"):
                    rows.append(
                        {
                            "sample": wildcards.sample,
                            "partition": None,
                            "method": "RELAX",
                            "metric": "status",
                            "value": "skipped",
                        }
                    )
                else:
                    tr = relax_data.get("test results", {})
                    rows.append(
                        {
                            "sample": wildcards.sample,
                            "partition": "All",
                            "method": "RELAX",
                            "metric": "k",
                            "value": tr.get(
                                "relaxation or intensification parameter", None
                            ),
                        }
                    )
                    rows.append(
                        {
                            "sample": wildcards.sample,
                            "partition": "All",
                            "method": "RELAX",
                            "metric": "pvalue",
                            "value": tr.get("p-value", None),
                        }
                    )
            if input.get("ABSREL"):
                for absrel_part in input.ABSREL:
                    absrel_data = _read_json(absrel_part)
                    part_match = re.search(r"/part(\d+)/", str(absrel_part))
                    partition = int(part_match.group(1)) if part_match else None
                    branch_attrs = absrel_data.get("branch attributes", {}).get(
                        "0", {}
                    )
                    sig = 0
                    for _, vals in branch_attrs.items():
                        if not isinstance(vals, dict):
                            continue
                        cp = vals.get("Corrected P-value", 1.0)
                        try:
                            cp = float(cp)
                        except (TypeError, ValueError):
                            cp = 1.0
                        if cp <= 0.10:
                            sig += 1
                    rows.append(
                        {
                            "sample": wildcards.sample,
                            "partition": partition,
                            "method": "ABSREL",
                            "metric": "significant_branches",
                            "value": sig,
                        }
                    )
            if input.get("CFEL"):
                for cfel_part in input.CFEL:
                    cfel_data = _read_json(cfel_part)
                    part_match = re.search(r"/part(\d+)/", str(cfel_part))
                    partition = int(part_match.group(1)) if part_match else None
                    try:
                        headers = [x[0] for x in cfel_data["MLE"]["headers"]]
                        df = pd.DataFrame(
                            cfel_data["MLE"]["content"]["0"], columns=headers
                        )
                        pcol = next(
                            (c for c in headers if "p-value" in c.lower()), None
                        )
                        sig = (
                            int(
                                (
                                    pd.to_numeric(df[pcol], errors="coerce") <= 0.10
                                ).sum()
                            )
                            if pcol
                            else 0
                        )
                    except Exception:
                        sig = 0
                    rows.append(
                        {
                            "sample": wildcards.sample,
                            "partition": partition,
                            "method": "CFEL",
                            "metric": "significant_sites_p_0.10",
                            "value": sig,
                        }
                    )
        out = pd.DataFrame(
            rows, columns=["sample", "partition", "method", "metric", "value"]
        )
        out.to_csv(output.csv, index=False)


###############################################################################
# End of file
