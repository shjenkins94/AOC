rule TableBUSTEDS_MH:
    input:
        json=rules.BUSTEDS_MH.output.json,
    output:
        csv="results/{sample}/tables/{sample}.AOC.BUSTEDS-MH_Results.csv",
    log:
        "logs/TableBUSTEDS_MH.{sample}.log",
    run:
        data = _read_json(input.json)
        rows = []
        if data.get("skipped"):
            rows.append(
                {
                    "Sample": wildcards.sample,
                    "Partition": None,
                    "test": "BUSTEDS-MH",
                    "p_value": None,
                    "LRT": None,
                    "tested_branches": None,
                    "background_branches": None,
                    "status": "skipped",
                }
            )
        else:
            # -------------------------------
            # test results
            # -------------------------------
            tr = data.get("test results", {})
            pval = tr.get("p-value", None)
            lrt = tr.get("LRT", None)
            # -------------------------------
            # tested/background branches
            # structure differs across HyPhy versions
            # -------------------------------
            branch_counts = _count_branches(data)
            rows.append(
                {
                    "Sample": wildcards.sample,
                    "Partition": int(wildcards.part),
                    "test": "BUSTEDS-MH",
                    "p_value": pval,
                    "LRT": lrt,
                    "tested_branches": branch_counts["tested"],
                    "background_branches": branch_counts["background"],
                    "status": "ok",
                }
            )
        df = pd.DataFrame(rows)
        os.makedirs(os.path.dirname(output.csv), exist_ok=True)
        df.to_csv(output.csv, index=False)


rule TableRELAX:
    input:
        json=rules.RELAX.output.json,
    output:
        csv="results/{sample}/tables/{sample}.AOC.RELAX_Results.csv",
    log:
        "logs/TableRELAX.{sample}.log",
    run:
        data = _read_json(input.json)
        rows = []
        if data.get("skipped"):
            rows.append(
                {
                    "Sample": wildcards.sample,
                    "Partition": None,
                    "test": "RELAX",
                    "k": None,
                    "p_value": None,
                    "LRT": None,
                    "selection_shift": None,
                    "status": "skipped",
                }
            )
        else:
            tr = data.get("test results", {})
            k = tr.get("relaxation or intensification parameter", None)
            try:
                k_num = float(k)
            except (TypeError, ValueError):
                k_num = None
            if k_num is None:
                shift = None
            elif k_num > 1:
                shift = "intensified"
            elif k_num < 1:
                shift = "relaxed"
            else:
                shift = "no_change"
            rows = [
                {
                    "Sample": wildcards.sample,
                    "Partition": int(wildcards.part),
                    "test": "RELAX",
                    "k": k,
                    "p_value": tr.get("p-value", None),
                    "LRT": tr.get("LRT", None),
                    "selection_shift": shift,
                    "status": "ok",
                }
            ]
        df = pd.DataFrame(rows)
        os.makedirs(os.path.dirname(output.csv), exist_ok=True)
        df.to_csv(output.csv, index=False)


rule TableABSREL_partition:
    input:
        json=rules.ABSREL_partition.output.json,
    output:
        csv="results/{sample}/tables/part{part}/{sample}.part{part}.AOC.ABSREL_Results.csv",
    log:
        "logs/TableABSREL_partition.{sample}.part{part}.log",
    run:
        data = _read_json(input.json)
        rows = []
        if data.get("skipped"):
            rows.append(
                {
                    "Sample": wildcards.sample,
                    "Partition": int(wildcards.part),
                    "Branch": None,
                    "Corrected P-value": None,
                    "Raw P-value": None,
                    "Rate classes": None,
                    "omega_max": None,
                    "significant_branch_0.10": None,
                    "status": "skipped",
                }
            )
        else:
            branch_attrs = data.get("branch attributes", {}).get("0", {})
            for branch, vals in branch_attrs.items():
                if not isinstance(vals, dict):
                    continue
                cp = vals.get("Corrected P-value", None)
                rp = vals.get("P-value", None)
                try:
                    cp_num = float(cp)
                except (TypeError, ValueError):
                    cp_num = None
                omega_vals = []
                for k, v in vals.items():
                    if (
                        isinstance(k, str)
                        and k.startswith("omega")
                        and isinstance(v, (int, float))
                    ):
                        omega_vals.append(v)
                omega_max = max(omega_vals) if omega_vals else None
                n_rate_classes = len(
                    [
                        k
                        for k in vals.keys()
                        if isinstance(k, str) and k.startswith("omega")
                    ]
                )
                rows.append(
                    {
                        "Sample": wildcards.sample,
                        "Partition": int(wildcards.part),
                        "Branch": branch,
                        "Corrected P-value": cp,
                        "Raw P-value": rp,
                        "Rate classes": n_rate_classes,
                        "omega_max": omega_max,
                        "significant_branch_0.10": (
                            int(cp_num <= 0.10) if cp_num is not None else 0
                        ),
                        "status": "ok",
                    }
                )
        df = pd.DataFrame(rows)
        df.to_csv(output.csv, index=False)


rule TableCFEL_partition:
    input:
        json=rules.CFEL_partition.output.json,
    output:
        csv="results/{sample}/tables/part{part}/{sample}.part{part}.AOC.CFEL_Results.csv",
    log:
        "logs/TableCFEL_partition.{sample}.part{part}.log",
    run:
        data = _read_json(input.json)
        if data.get("skipped"):
            df = pd.DataFrame(
                [
                    {
                        "Sample": wildcards.sample,
                        "Partition": int(wildcards.part),
                        "CodonSite": None,
                        "status": "skipped",
                    }
                ]
            )
        else:
            headers = _hyphy_headers(data)
            df = pd.DataFrame(_hyphy_content_table(data), columns=headers)
            df.index += 1
            df["CodonSite"] = df.index
            df.insert(0, "Partition", int(wildcards.part))
            df.insert(0, "Sample", wildcards.sample)
            df["status"] = "ok"
            pcol = next(
                (
                    c
                    for c in df.columns
                    if isinstance(c, str) and "p-value" in c.lower()
                ),
                None,
            )
            if pcol is not None:
                df["significant_site_0.10"] = (
                    pd.to_numeric(df[pcol], errors="coerce") <= 0.10
                ).astype(int)
            else:
                df["significant_site_0.10"] = 0
        df.to_csv(output.csv, index=False)


