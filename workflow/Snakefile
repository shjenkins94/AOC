    > TableRELAX
    > TableABSREL_partition
    > TableCFEL_partition
    > MergeABSRELCSVs
    > MergeCFELCSVs
    > SelectionOverviewTable


rule macse:
    input:
        fasta=lambda wildcards: CODON_FASTA_BY_SEQUENCE[wildcards.sequence],
    output:
        codons="results/by_sequence/{sequence}/{sequence}.codons.fa",
        aa="results/by_sequence/{sequence}/{sequence}.aa.fa",
    log:
        "logs/macse.{sequence}.log",
    resources:
        mem_mb=_macse_requested_mem_mb(),
        xms_mb=MACSE_XMS_MB,
        xmx_mb=_macse_heap_mb(),
    params:
        launcher=MACSE_LAUNCHER,
        runner=MACSE_RUNNER,
    shell:
        r"""
        bash "{params.runner}" \
            --macse-bin "{params.launcher}" \
            --xms-mb {resources.xms_mb} \
            --xmx-mb {resources.xmx_mb} \
            -- \
            -prog alignSequences \
            -seq "{input.fasta}" \
            -out_NT "{output.codons}" \
            -out_AA "{output.aa}" \
            -max_refine_iter 3 \
            -local_realign_init 0.3 \
            -local_realign_dec 0.2 \
            >{log} 2>&1
        """


rule cln:
    input:
        codons=rules.macse.output.codons,
    output:
        cln="results/by_sequence/{sequence}/{sequence}.codons.cln.fa",
    log:
        "logs/cln.{sequence}.log",
    shell:
        r"""
        {HYPHY} CLN Universal {input.codons} 'No/No' {output.cln} >{log} 2>&1
        """


rule strike_ambigs_msa:
    input:
        cln=rules.cln.output.cln,
    output:
        sa="results/by_sequence/{sequence}/{sequence}.SA.codons.cln.fa",
    log:
        "logs/strike_ambigs_msa.{sequence}.log",
    shell:
        r"""
        {HYPHY} {STRIKE_AMBIGS_BF} --alignment {input.cln} --output {output.sa} >{log} 2>&1
        """


rule remove_duplicates_msa:
    input:
        sa=rules.strike_ambigs_msa.output.sa,
    output:
        rd="results/by_sequence/{sequence}/{sequence}.RD.SA.codons.cln.fa",
    log:
        "logs/remove_duplicates_msa.{sequence}.log",
    shell:
        r"""
        {HYPHY} {REMOVE_DUPS_BF} --msa {input.sa} --output {output.rd} ENV='DATA_FILE_PRINT_FORMAT=9' >{log} 2>&1
        """


rule tn93_cluster:
    input:
        rd=rules.remove_duplicates_msa.output.rd,
    output:
        cluster_json="results/by_sequence/{sequence}/{sequence}.RD.SA.codons.cln.fa.cluster.json",
        cluster_fasta="results/by_sequence/{sequence}/{sequence}.RD.SA.codons.cln.fa.cluster.fasta",
    log:
        "logs/tn93_cluster.{sequence}.log",
    params:
        threshold=lambda wildcards: config.get("tn93_threshold", 0.01),
        max_seqs=lambda wildcards: config.get("tn93_max_seqs", 20),
    shell:
        r"""
        python {TN93_CLUSTER_PY} \
            --input {input.rd} \
            --output_fasta {output.cluster_fasta} \
            --output_json {output.cluster_json} \
            --threshold {params.threshold} \
            --max_retain {params.max_seqs} \
            >{log} 2>&1
        """


###############################################################################
# Test headers -> header map + test list (only used when test_headers exists)
###############################################################################


def _get_msa(wildcards):
    if KEEP_ALL_SEQUENCES:
        return rules.strike_ambigs_msa.output.sa
    else:
        return rules.tn93_cluster.output.cluster_fasta


checkpoint check_msa:
    input:
        msa=_get_msa,
        raw_headers=lambda wildcards: (
            TEST_HEADERS_BY_SAMPLE[wildcards.sample]
            if TEST_HEADERS_BY_SAMPLE.get(wildcards.sample, False)
            else []
        ),
    output:
        map_csv="results/{sample}/{sample}.{sequence}.sequence_header_map.csv",
        test_txt="results/{sample}/{sample}.{sequence}.test_sequences.txt",
        filtered_ids="results/{sample}/{sample}.{sequence}.test_sequences.filtered.txt",
    log:
        "logs/check_msa.{sample}.{sequence}.log",
    params:
        test_headers_arg=lambda wildcards, input: (
            f"--test-headers {input.raw_headers}" if input.raw_headers else ""
        ),
    shell:
        r"""
        python {CHECK_MSA_PY} \
            --msa {input.msa} \
            {params.test_headers_arg} \
            --out-map {output.map_csv} \
            --out-test {output.test_txt} \
            --out-test-in-msa {output.filtered_ids} \
            >{log} 2>&1
        """


rule recombination:
    input:
        msa=_get_msa,
    output:
        gard_json="results/by_sequence/{sequence}/{sequence}.RD.SA.codons.cln.fa.cluster.fasta.GARD.json",
        bestgard="results/by_sequence/{sequence}/{sequence}.RD.SA.codons.cln.fa.cluster.fasta.best-gard",
    log:
        "logs/recombination.{sequence}.log",
    params:
        hyphy_command=lambda wildcards, resources: (
            f"{resources.mpi} -n {resources.tasks} {HYPHYMPI}"
            if config.get("use_mpi", False)
            else HYPHY
        ),
    shell:
        r"""
        {params.hyphy_command} GARD --alignment {input.msa} --rv GDD --output {output.gard_json} --mode Faster ENV='TOLERATE_NUMERICAL_ERRORS=1;' \
            >{log} 2>&1
        """


###############################################################################
# CHECKPOINT: parse best-gard -> write ALL partitions (multiple-of-3 enforced)
###############################################################################


checkpoint parse_gard:
    input:
        bestgard=rules.recombination.output.bestgard,
        msa=_get_msa,
    output:
        segflag=touch("results/by_sequence/{sequence}/gard/segments/GARD_parsed.done"),
        manifest="results/by_sequence/{sequence}/gard/segments.json",
        log="results/by_sequence/{sequence}/{sequence}.gard.log",
    params:
        segments_dir=lambda wildcards, output: Path(output["segflag"]).parent,
    run:
        # Logging for checkpoint: use output.log (gard.log)
        data = [line.strip() for line in open(input.bestgard) if "CHARSET" in line]
        if not data:
            raise ValueError(
                "[ERROR] GARD results file is empty or improperly formatted (no CHARSET lines)."
            )
        data_parsed = [
            [int(x) for x in line.split("=")[1].strip(" ;").split("-")]
            for line in data
        ]
        data_adjusted = [[start - 1, end] for start, end in data_parsed]
        records = list(SeqIO.parse(input.msa, "fasta"))
        if not records:
            raise ValueError(f"[ERROR] Empty MSA: {input.msa}")
        first_seq = str(records[0].seq)
        data_adjusted_coords = []
        carryOver = 0
        for start, end in data_adjusted:
            start = start - carryOver
            seg_len = len(first_seq[int(start) : int(end)])
            remainder = seg_len % 3
            data_adjusted_coords.append([start, end - remainder])
            carryOver = remainder
        manifest = {
            "sample": wildcards.sequence,
            "msa": str(input.msa),
            "bestgard": str(input.bestgard),
            "n_parts": len(data_adjusted_coords),
            "parts": [],
        }
        with open(output.log, "w") as log_file:
            for i, (start, stop) in enumerate(data_adjusted_coords, start=1):
                out_fa = (
                    params.segments_dir / f"{wildcards.sequence}.part{i}.codon.fas"
                )
                with open(out_fa, "w") as out_f:
                    for record in records:
                        partition = record[int(start) : int(stop)]
                        out_f.write(f">{record.id}\n{partition.seq}\n")
                adjusted_len = len(records[0][int(start) : int(stop)].seq)
                log_file.write(
                    f"Partition {i}: start={start}, stop={stop}, length={adjusted_len}, remainder={adjusted_len % 3}\n"
                )
                manifest["parts"].append(
                    {
                        "part": i,
                        "start0": int(start),
                        "end_excl": int(stop),
                        "fasta": str(out_fa),
                        "length": int(adjusted_len),
                    }
                )
        with open((output.manifest), "w") as fh:
            json.dump(manifest, fh, indent=2)


###############################################################################
# Dynamic fan-out utilities (for partitions)
###############################################################################


def _parts_for_sample(wildcards):
    ck = checkpoints.parse_gard.get(sequence=SEQUENCE_BY_SAMPLE[wildcards.sample])
    with open(ck.output.manifest) as fh:
        m = json.load(fh)
    return [str(p["part"]) for p in m["parts"]]


def _partition_fasta(wildcards):
    sequence = SEQUENCE_BY_SAMPLE[wildcards.sample]
    return f"results/by_sequence/{sequence}/gard/segments/{sequence}.part{wildcards.part}.codon.fas"


###############################################################################
# Selection analysis for all partitions (using GARD output)
###############################################################################


rule label_gard_TestForeground:
    input:
        bestgard=lambda wildcards: expand(
            "results/by_sequence/{sequence}/{sequence}.RD.SA.codons.cln.fa.cluster.fasta.best-gard",
            sequence=SEQUENCE_BY_SAMPLE[wildcards.sample],
        ),
        test_list=lambda wildcards: f"results/{{sample}}/{{sample}}.{SEQUENCE_BY_SAMPLE[wildcards.sample]}.test_sequences.txt",
    output:
        labelgard=os.path.join(
            "results/by_sequence/{sample}/{sample}.RD.SA.codons.cln.fa.cluster.fasta.best-gard.labeled",
        ),
    log:
        "logs/label_gard_TestForeground.{sample}.log",
    run:
        logp = log[0] if hasattr(log, "__iter__") else str(log)
        with open(logp, "a") as L:
            L.write("START\n")
        if (
            (input.test_list is None)
            or (not os.path.exists(input.test_list))
            or (os.path.getsize(input.test_list) == 0)
        ):
            shell(f"cp {input.bestgard} {output.labelgard}")
            with open(logp, "a") as L:
                L.write("No test list, using best-gard file directly\nEND\n")
        else:
            shell(
                f"{HYPHY} {LABEL_GARD_BF} {input.bestgard} "
                f"--list {input.test_list} --output {output.labelgard} "
                f"--label Test > {log} 2>&1"
            )
            with open(logp, "a") as L:
                L.write("END\n")


rule FEL:
    input:
        aln=rules.label_gard_TestForeground.output.labelgard,
    output:
        json="results/{sample}/selection/{sample}.FEL.json",
    log:
        "logs/FEL.{sample}.log",
    params:
        branch_arg=lambda wildcards: _branch_arg_gard(wildcards.sample),
    shell:
        r"""
        {HYPHY} FEL --alignment {input.aln} --output {output.json} --ci Yes {params.branch_arg} >{log} 2>&1
        """


rule MEME:
    input:
        aln=rules.label_gard_TestForeground.output.labelgard,
    output:
        json="results/{sample}/selection/{sample}.MEME.json",
    log:
        "logs/MEME.{sample}.log",
    params:
        branch_arg=lambda wildcards: _branch_arg_gard(wildcards.sample),
    shell:
        r"""
        {HYPHY} MEME --alignment {input.aln} --output {output.json} {params.branch_arg} ENV='TOLERATE_NUMERICAL_ERRORS=1;' >{log} 2>&1
        """


rule BUSTEDS_MH:
    input:
        aln=rules.label_gard_TestForeground.output.labelgard,
    output:
        json="results/{sample}/selection/{sample}.BUSTEDS-MH.json",
    log:
        "logs/BUSTEDS_MH.{sample}.log",
    params:
        branch_arg=lambda wildcards: _branch_arg_gard(wildcards.sample),
    shell:
        r"""
        {HYPHY} BUSTED \
            --alignment {input.aln} \
            --output {output.json} \
            --srv Yes \
            --multiple-hits Double+Triple \
            {params.branch_arg} \
            >{log} 2>&1
        """


rule RELAX:
    input:
        aln=rules.label_gard_TestForeground.output.labelgard,
