MACSE_LAUNCHER = config.get("macse_launcher", "macse")
MACSE_HEAP_FRACTION = float(config.get("macse_heap_fraction", 0.875))
MACSE_HEAP_RESERVE_MB = int(config.get("macse_heap_reserve_mb", 1024))
MACSE_MIN_HEAP_MB = int(config.get("macse_min_heap_mb", 2048))
MACSE_XMS_MB = int(config.get("macse_xms_mb", 512))


def _coerce_bool(value):
    if isinstance(value, bool):
        return value
    if value is None:
        return False
    return str(value).strip().lower() in {"1", "true", "yes", "y", "on"}

def _coerce_int(value):
    try:
        return int(str(value).strip())
    except (TypeError, ValueError, AttributeError):
        return None

def _is_missing(x):
    if x is None:
        return True
    if isinstance(x, float) and math.isnan(x):
        return True
    s = str(x).strip()
    return (s == "") or (s.lower() == "nan")

PRESERVE_TEST_SEQUENCES = _coerce_bool(PRESERVE_TEST_SEQUENCES_RAW)
RESTORE_ALL_SEQUENCES = _coerce_bool(RESTORE_ALL_SEQUENCES_RAW)

def _slurm_mem_mb():
    per_node = _coerce_int(os.environ.get("SLURM_MEM_PER_NODE"))
    if per_node:
        return per_node

    per_cpu = _coerce_int(os.environ.get("SLURM_MEM_PER_CPU"))
    cpus = _coerce_int(os.environ.get("SLURM_CPUS_PER_TASK"))
    if per_cpu and cpus:
        return per_cpu * cpus

    return None

def _macse_requested_mem_mb():
    explicit = _coerce_int(config.get("macse_mem_mb"))
    if explicit:
        return explicit
    return _slurm_mem_mb() or MACSE_MIN_HEAP_MB

def _macse_heap_mb():
    explicit_heap = _coerce_int(config.get("macse_heap_mb"))
    if explicit_heap:
        return explicit_heap

    requested = _macse_requested_mem_mb()
    baseline = min(MACSE_MIN_HEAP_MB, requested)
    heap_from_fraction = int(requested * MACSE_HEAP_FRACTION)
    heap_after_reserve = requested - MACSE_HEAP_RESERVE_MB
    usable = min(heap_from_fraction, heap_after_reserve) if heap_after_reserve > 0 else heap_from_fraction
    return max(baseline, min(requested, usable))

###############################################################################
# Read samples.csv
###############################################################################

samples_df = pd.read_csv(SAMPLES_CSV).copy()
if "sample" not in samples_df.columns:
    raise ValueError("samples.csv missing required column ['sample']")
if "sequence_labels_csv" not in samples_df.columns:
    samples_df["sequence_labels_csv"] = ""

samples_df["sample"] = samples_df["sample"].astype(str)

if "sequence" in samples_df.columns:
    samples_df["sequence"] = samples_df["sequence"].astype(str)
else:
    samples_df["sequence"] = samples_df["sample"].astype(str)

if "codon_fasta" in samples_df.columns:
    sequence_fasta_df = (
        samples_df[["sequence", "codon_fasta"]]
        .dropna(subset=["codon_fasta"])
        .drop_duplicates()
        .copy()
    )
else:
    if not os.path.exists(SEQUENCES_CSV):
        raise ValueError(
            "samples.csv must include either a 'codon_fasta' column or a 'sequence' column "
            f"paired with sequences_csv={SEQUENCES_CSV!r}"
        )
    sequence_fasta_df = pd.read_csv(SEQUENCES_CSV).copy()
    required_sequences = {"sequence", "codon_fasta"}
    missing_sequences = required_sequences.difference(sequence_fasta_df.columns)
    if missing_sequences:
        raise ValueError(f"sequences.csv missing required columns {sorted(missing_sequences)}")

sequence_fasta_df["sequence"] = sequence_fasta_df["sequence"].astype(str)
sequence_fasta_df["codon_fasta"] = sequence_fasta_df["codon_fasta"].astype(str)
duplicate_sequence_paths = sequence_fasta_df.groupby("sequence")["codon_fasta"].nunique()
ambiguous_sequences = duplicate_sequence_paths[duplicate_sequence_paths > 1].index.tolist()
if ambiguous_sequences:
    raise ValueError(f"Each sequence must map to exactly one codon_fasta; ambiguous sequences: {ambiguous_sequences}")

SAMPLES = samples_df["sample"].tolist()
SEQUENCES = list(dict.fromkeys(samples_df["sequence"].tolist()))
SEQUENCE_BY_SAMPLE = dict(zip(samples_df["sample"], samples_df["sequence"]))
CODON_FASTA_BY_SEQUENCE = dict(zip(sequence_fasta_df["sequence"], sequence_fasta_df["codon_fasta"]))
missing_sequence_paths = [seq for seq in SEQUENCES if seq not in CODON_FASTA_BY_SEQUENCE]
if missing_sequence_paths:
    raise ValueError(f"No codon_fasta entry found for sequences: {missing_sequence_paths}")

LABELS_CSV_BY_SAMPLE  = dict(zip(samples_df["sample"], samples_df["sequence_labels_csv"].astype(str)))
LABELS_CSV_BY_SAMPLE = {
    k: v for k, v in LABELS_CSV_BY_SAMPLE.items() if not _is_missing(v)
}

def sequence_for_sample(sample):
    return SEQUENCE_BY_SAMPLE[sample]

SAMPLES_WITH_LABELS = list(LABELS_CSV_BY_SAMPLE.keys())

SAMPLES_WITH_LABELS_BY_SEQUENCE = {
    sequence: [s for s in SAMPLES_WITH_LABELS if sequence_for_sample(s) == sequence]
    for sequence in SEQUENCES
}


###############################################################################
# Utility: ensure empty test list exists for unlabeled samples
###############################################################################

def test_list_file(sample):
    return f"results/{sample}/{sample}.test_sequences.txt"

def _test_list_for_sample(wc):
    if LABELS_CSV_BY_SAMPLE.get(wc.sample, False):
        return f"results/{wc.sample}/{wc.sample}.test_sequences.txt"
    else:
        return f"results/{wc.sample}/{wc.sample}.test_sequences.EMPTY.txt"

def _alignment_to_restore(sequence):
    if RESTORE_ALL_SEQUENCES:
        return f"results/sequences/{sequence}/{sequence}.SA.codons.cln.fa"
    else:
        return f"results/sequences/{sequence}/{sequence}.RD.SA.codons.cln.fa"

def _branch_arg(sample):
    if LABELS_CSV_BY_SAMPLE.get(sample, False):
        return "--branches Test"
    return ""

# Seems like nexus files get imported with all-uppercase labels, so use TEST
def _branch_arg_direct(sample):
    if LABELS_CSV_BY_SAMPLE.get(sample, False):
        return "--branches TEST"
    return ""

def _preserve_test_list_input(wc):
    if PRESERVE_TEST_SEQUENCES:
        return [test_list_file(s) for s in SAMPLES_WITH_LABELS_BY_SEQUENCE.get(wc.sequence, [])]
    return []

def _read_preserve_names(path):
    if not path:
        return []
    if isinstance(path, (list, tuple)):
        names = []
        for p in path:
            names.extend(_read_preserve_names(p))
        return list(dict.fromkeys(names))
    if not os.path.exists(str(path)):
        return []
    with open(str(path)) as fh:
        return [line.strip() for line in fh if line.strip()]

def _fasta_ids(path):
    return {record.id for record in SeqIO.parse(str(path), "fasta")}

def _restore_missing_preserved_sequences(source_fasta, output_fasta, preserve_names, log_file):
    if not preserve_names:
        return

    present = _fasta_ids(output_fasta)
    missing = [name for name in preserve_names if name not in present]
    if not missing:
        return

    records_by_id = {record.id: record for record in SeqIO.parse(str(source_fasta), "fasta")}
    unavailable = [name for name in missing if name not in records_by_id]
    if unavailable:
        raise RuntimeError(
            f"Could not preserve requested Test sequences because they were not found in {source_fasta}: {unavailable}"
        )

    with open(str(output_fasta), "a") as out:
        SeqIO.write([records_by_id[name] for name in missing], out, "fasta")

    with open(str(log_file), "a") as L:
        L.write(f"\n[INFO] Restored {len(missing)} preserved Test sequences after duplicate removal: {missing}\n")

def _assert_preserved_sequences(output_fasta, preserve_names):
    if not preserve_names:
        return

    present = _fasta_ids(output_fasta)
    missing = [name for name in preserve_names if name not in present]
    if missing:
        raise RuntimeError(
            f"Preserved Test sequences are missing from {output_fasta}: {missing}"
        )

